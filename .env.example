# LinkedIn app credentials (from LinkedIn developer app)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8788/callback
LINKEDIN_SCOPES='w_member_social openid profile'

# LinkedIn runtime auth values (filled after OAuth)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN_EXPIRES_IN=
LINKEDIN_REFRESH_TOKEN_EXPIRES_IN=
LINKEDIN_AUTHOR_URN=urn:li:person:

# Optional LinkedIn API version override (YYYYMM)
LINKEDIN_API_VERSION=202601

# X (Twitter) app credentials/settings
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8789/callback
X_SCOPES='tweet.read tweet.write users.read media.write offline.access'

# X (Twitter) runtime auth values
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_ACCESS_TOKEN_EXPIRES_IN=

# Substack Notes browser-session authentication (no OAuth flow)
# Copy only the value of the substack.sid cookie. Treat it like a password.
SUBSTACK_SESSION_TOKEN=
SUBSTACK_PUBLICATION_URL=https://yourname.substack.com
